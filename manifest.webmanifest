{
  "id": "./",
  "name": "BassCast SA",
  "short_name": "BassCast",
  "description": "Bass fishing conditions, best fishing windows and bait advice for South African dams.",
  "lang": "en-ZA",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#EDF1EF",
  "background_color": "#EDF1EF",
  "categories": ["sports", "weather", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "related_applications": [
    { "platform": "webapp", "url": "https://theunissteyn.github.io/basscast-sa/manifest.webmanifest" }
  ],
  "prefer_related_applications": false
}
